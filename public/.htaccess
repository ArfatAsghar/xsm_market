Options -MultiViews
RewriteEngine On

# Route all /api/* requests to the PHP backend
RewriteRule ^api/?(.*)$ php-backend/index.php [L,QSA]

# For all other non-file/non-directory requests, serve index.html (React Router SPA)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]
